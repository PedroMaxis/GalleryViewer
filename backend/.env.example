# Porta da API (padrão 5000)
PORT=5000
# Arquivo do banco SQLite (padrão ./database.db). Em hospedagem, aponte para um disco persistente.
DATABASE_FILE=./database.db
# Tamanho máximo de cada imagem, em MB (padrão 8)
MAX_UPLOAD_MB=8
# Origens autorizadas a chamar a API, separadas por vírgula. Vazio = qualquer origem (só para desenvolvimento).
ALLOWED_ORIGINS=http://localhost:5173
